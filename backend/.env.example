# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stocklyzer

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-secret-in-production

# Google OAuth (from Google Cloud Console -> Credentials -> OAuth Client ID, type "Web application")
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Anthropic API key for the AI insights feature (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# The deployed frontend URL, for CORS (e.g. https://stocklyzer.vercel.app)
FRONTEND_ORIGIN=http://localhost:5173
